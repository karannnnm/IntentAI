{
  "name": "intent-ai",
  "version": "1.0.0",
  "description": "AI-powered binary intent detection through assembly analysis",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "npx ts-node src/index.ts",
    "start": "node dist/index.js",
    "collect:windows": "npx ts-node scripts/collect-files.ts",
    "collect:mac": "npx ts-node scripts/collect-files-mac.ts",
    "analyze": "npx ts-node scripts/analyze-binaries.ts",
    "label": "npx ts-node scripts/label-binaries.ts",
    "build-dataset": "npx ts-node scripts/build-training-dataset.ts",

    "//": "Fixtures workflow (macOS/arm64-first): compile our own small programs, then analyze them.",
    "fixtures:build": "npx ts-node scripts/build-fixtures.ts",
    "fixtures:collect": "npx ts-node scripts/collect-fixtures.ts",
    "fixtures:analyze": "npx ts-node scripts/analyze-binaries.ts data/raw/collected-fixtures.json",
    "fixtures:dataset": "npx ts-node scripts/build-training-dataset.ts --embedded"
  },
  "keywords": [
    "reverse-engineering",
    "assembly",
    "ai",
    "binary-analysis"
  ],
  "author": "Karan Modi",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@alexaltea/capstone-js": "^3.0.5",
    "axios": "^1.6.0"
  }
}
